<?xml version="1.0" encoding="utf-8"?>
<!--
  The primary button's fill, as a state list rather than a flat colour.

  A flat `backgroundTint` left the button looking fully enabled while
  `isEnabled` was false — the PIN sheet's "Davom etish" is disabled until all
  eight digits are in, and it read as tappable the whole time. A control that
  looks live and does nothing is worse than either state on its own.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/eimzo_ui_accent_disabled" android:state_enabled="false" />
    <item android:color="@color/eimzo_ui_accent" />
</selector>
