<?xml version="1.0" encoding="utf-8"?>
<!-- "+ Kalit qo'shish" closing the key list (C7): a dashed outline at radius
     18, an invitation rather than one more key. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/eimzo_ui_accent_26">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1.5dp"
                android:color="@color/eimzo_ui_dashed"
                android:dashGap="5dp"
                android:dashWidth="6dp" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</ripple>
