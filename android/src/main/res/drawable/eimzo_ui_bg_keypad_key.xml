<?xml version="1.0" encoding="utf-8"?>
<!-- A 64dp round key. The design gives it a soft drop shadow in light mode;
     that is carried by the view's elevation rather than redrawn here, because a
     shape drawable cannot cast one. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/eimzo_ui_keypad_key" />
</shape>
