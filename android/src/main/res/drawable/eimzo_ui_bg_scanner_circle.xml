<?xml version="1.0" encoding="utf-8"?>
<!-- The scanner's round buttons (C1): white at 12% over the camera picture.
     The torch's state list adds a brighter fill while it is on. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="oval">
            <solid android:color="#59FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#1FFFFFFF" />
        </shape>
    </item>
</selector>
