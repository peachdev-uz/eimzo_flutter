<?xml version="1.0" encoding="utf-8"?>
<!--
  The teal key card (1a / 3d). Three stops, not two: the design's gradient turns
  through #166E7E at 46% before it reaches the green end, and a straight
  two-stop ramp between the outer colours misses that turn and reads flat.

  Angle 315 is top-left to bottom-right, matching the design's
  `begin: topLeft, end: bottomRight`. Colours come from values/-night so the
  card darkens with the theme.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:centerColor="@color/eimzo_ui_card_gradient_mid"
        android:endColor="@color/eimzo_ui_card_gradient_end"
        android:startColor="@color/eimzo_ui_card_gradient_start"
        android:type="linear" />
    <corners android:radius="20dp" />
</shape>
