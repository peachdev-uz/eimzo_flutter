<?xml version="1.0" encoding="utf-8"?>
<!-- The password field (C3): 56 high at radius 16 with a 1.5 accent border,
     inside a 4dp accent glow ring — the app's focused input. The ring is drawn
     in the view's outer 4dp, so the view is 64 high with -4 side margins. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/eimzo_ui_accent_12" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/eimzo_ui_field" />
            <stroke
                android:width="1.5dp"
                android:color="@color/eimzo_ui_accent" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
