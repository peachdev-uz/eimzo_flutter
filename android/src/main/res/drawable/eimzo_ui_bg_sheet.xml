<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom-sheet surface. 32dp on the top corners only — DsSheet's radius,
     which is larger than the token scale's `rSheet` (24dp); the sheet is the
     one place the design goes rounder. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/eimzo_ui_sheet" />
    <corners
        android:topLeftRadius="32dp"
        android:topRightRadius="32dp" />
</shape>
