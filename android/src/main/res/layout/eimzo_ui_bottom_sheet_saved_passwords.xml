<?xml version="1.0" encoding="utf-8"?>
<!--
  F2 — "Saqlangan parollar": which keys have a password or PIN stored, each
  with its own "O'chirish", and "Hammasini o'chirish" at the foot. The row in
  Settings used to forget every one of them at once, with no way to see which.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/eimzo_ui_bg_sheet"
    android:fillViewport="true"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="44dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/eimzo_ui_sheet_grabber" />

        <TextView
            android:id="@+id/savedTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/eimzo_ui_saved_passwords"
            android:textColor="@color/eimzo_ui_text"
            android:textSize="21sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/savedList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/eimzo_ui_bg_group"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteAllSaved"
            style="@style/Widget.Eimzo.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:minHeight="52dp"
            android:text="@string/eimzo_ui_delete_all"
            android:textColor="@color/eimzo_ui_danger_text" />
    </LinearLayout>
</ScrollView>
