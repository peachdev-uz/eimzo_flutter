<?xml version="1.0" encoding="utf-8"?>
<!--
  3g — signed, with the way back to the site that asked.

  Measured off the design frame: gutter 30 (wider than 3f's 20 — this screen is
  one statement, not a list), chip 29 high at radius 999, the success mark as
  three concentric circles (186 / 166 halo at accent 26%, 104 solid accent),
  title 26sp, details card 333×89 at radius 18, the counting button 58 high at
  radius 16 with its label in #08251E, "Ilovada qolish" 52 at radius 16.

  Only reached from a deep link: the browser that opened the SDK is still on
  the page polling for this signature, so the useful thing is to put the user
  back on it.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eimzo_ui_background"
    android:paddingStart="30dp"
    android:paddingEnd="30dp">

    <!-- Where the signature went, said before anything else. -->
    <LinearLayout
        android:id="@+id/chipDomain"
        android:layout_width="wrap_content"
        android:layout_height="29dp"
        android:layout_marginTop="44dp"
        android:background="@drawable/eimzo_ui_bg_domain_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:importantForAccessibility="no"
            android:src="@drawable/eimzo_ui_ic_link"
            app:tint="@color/eimzo_ui_text_muted" />

        <TextView
            android:id="@+id/tvDomain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textColor="@color/eimzo_ui_text_secondary"
            android:textSize="12sp"
            tools:text="my.gov.uz" />
    </LinearLayout>

    <!-- ── Success mark: 186 halo → 166 halo → 104 solid disc ─────────── -->
    <FrameLayout
        android:id="@+id/mark"
        android:layout_width="186dp"
        android:layout_height="186dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/eimzo_ui_bg_success_halo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chipDomain">

        <FrameLayout
            android:layout_width="166dp"
            android:layout_height="166dp"
            android:layout_gravity="center"
            android:background="@drawable/eimzo_ui_bg_success_halo">

            <FrameLayout
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_gravity="center"
                android:background="@drawable/eimzo_ui_bg_success_disc">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/eimzo_ui_ic_check"
                    app:tint="@color/eimzo_ui_on_accent" />
            </FrameLayout>
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/eimzo_ui_signed_title"
        android:textColor="@color/eimzo_ui_text"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/mark" />

    <TextView
        android:id="@+id/tvBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/eimzo_ui_text_muted"
        android:textSize="14.5sp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        tools:text="Imzo saytga yuborildi. Endi my.gov.uz sahifasiga qaytishingiz mumkin." />

    <!-- What was signed and when — the receipt. -->
    <LinearLayout
        android:id="@+id/details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="23dp"
        android:background="@drawable/eimzo_ui_bg_receipt"
        android:orientation="vertical"
        android:paddingStart="19dp"
        android:paddingTop="17dp"
        android:paddingEnd="19dp"
        android:paddingBottom="17dp"
        app:layout_constraintTop_toBottomOf="@id/tvBody">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/eimzo_ui_key_label_plain"
                android:textColor="@color/eimzo_ui_text_hint"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvKeyName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.6"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="@color/eimzo_ui_text_secondary"
                android:textSize="13sp"
                tools:text="BAXTIYOROV X." />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="11dp"
            android:layout_marginBottom="11dp"
            android:background="@color/eimzo_ui_divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/eimzo_ui_time_label"
                android:textColor="@color/eimzo_ui_text_hint"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvSignedAt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/eimzo_ui_text_secondary"
                android:textSize="13sp"
                tools:text="10.08.2026 09:41:22" />
        </LinearLayout>
    </LinearLayout>

    <!-- ── Actions ────────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="34dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <!--
          The countdown fills this button from the left. The bar IS the timer:
          it is the only thing saying the SDK is about to close itself, so it
          belongs on the button that will fire.
        -->
        <FrameLayout
            android:id="@+id/btnReturn"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/eimzo_ui_bg_counting_button"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <View
                android:id="@+id/countFill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="#42FFFFFF" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/eimzo_ui_ic_open_in_new"
                    app:tint="@color/eimzo_ui_on_accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/eimzo_ui_return_to_site"
                    android:textColor="@color/eimzo_ui_on_accent"
                    android:textSize="16.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="13dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:importantForAccessibility="no"
                android:src="@drawable/eimzo_ui_ic_timer"
                app:tint="@color/eimzo_ui_text_hint" />

            <TextView
                android:id="@+id/tvCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/eimzo_ui_text_hint"
                android:textSize="12sp"
                tools:text="3 soniyadan so‘ng avtomatik ochiladi" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnStay"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/eimzo_ui_bg_stay_button"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:importantForAccessibility="no"
                android:src="@drawable/eimzo_ui_ic_back"
                app:tint="@color/eimzo_ui_text_muted" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:text="@string/eimzo_ui_stay_in_app"
                android:textColor="@color/eimzo_ui_text_secondary"
                android:textSize="15.5sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
