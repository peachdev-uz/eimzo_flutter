<?xml version="1.0" encoding="utf-8"?>
<!--
  3g / C10 — signed: the app's SignedSuccessView. Dark in both themes
  (#0E1F26) with an accent glow behind the top; a 124dp accent badge that pops
  in once; "Imzolandi"; where the signature went; a receipt (KALIT, Vaqt).

  A deep link's request: "Saytga qaytish", filling over three seconds while
  the caption counts 3 → 2 → 1, then «Ilovada qolish». A request scanned in
  the SDK: one "Tayyor" — there is no site on this phone to go back to.

  The content scrolls and the actions stay put: a button that fires itself
  must never be below the fold.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/signedRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eimzo_ui_signed_bg">

    <View
        android:layout_width="match_parent"
        android:layout_height="430dp"
        android:background="@drawable/eimzo_ui_bg_signed_glow"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/signedColumn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="20dp"
                android:paddingBottom="12dp">

                <!-- Where the signature went, said before anything else. -->
                <LinearLayout
                    android:id="@+id/chipDomain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="22dp"
                    android:background="@drawable/eimzo_ui_bg_domain_chip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="9dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="13dp"
                    android:paddingBottom="6dp">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/eimzo_ui_ic_link"
                        app:tint="@color/eimzo_ui_signed_muted" />

                    <TextView
                        android:id="@+id/tvDomain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:textColor="#C2D2D4"
                        android:textSize="12sp"
                        tools:text="my.gov.uz" />
                </LinearLayout>

                <!-- The badge: 124 accent, the tick in #08251E. -->
                <FrameLayout
                    android:id="@+id/badge"
                    android:layout_width="124dp"
                    android:layout_height="124dp"
                    android:background="@drawable/eimzo_ui_bg_success_disc"
                    android:elevation="18dp"
                    android:importantForAccessibility="no"
                    android:outlineAmbientShadowColor="@color/eimzo_ui_accent"
                    android:outlineSpotShadowColor="@color/eimzo_ui_accent"
                    tools:targetApi="p">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/eimzo_ui_ic_check"
                        app:tint="#08251E" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="34dp"
                    android:gravity="center"
                    android:letterSpacing="-0.01"
                    android:text="@string/eimzo_ui_signed_title"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.3"
                    android:textColor="@color/eimzo_ui_signed_muted"
                    android:textSize="14.5sp"
                    tools:text="Imzo saytga yuborildi. Endi my.gov.uz sahifasiga qaytishingiz mumkin." />

                <!-- The receipt. The labels wrap rather than squeeze the
                     values out at a large font size (D1). -->
                <LinearLayout
                    android:id="@+id/details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:background="@drawable/eimzo_ui_bg_receipt"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="18dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="18dp">

                    <LinearLayout
                        android:id="@+id/rowKey"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="16dp"
                            android:text="@string/eimzo_ui_key_label"
                            android:textColor="@color/eimzo_ui_signed_label"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvKeyName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:gravity="end"
                            android:maxLines="2"
                            android:textAllCaps="true"
                            android:textColor="#EAF2F1"
                            android:textSize="13sp"
                            tools:text="TOSHMATOV ALISHER" />
                    </LinearLayout>

                    <View
                        android:id="@+id/rowDivider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="#12FFFFFF" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="16dp"
                            android:text="@string/eimzo_ui_time_label"
                            android:textColor="@color/eimzo_ui_signed_label"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvSignedAt"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFeatureSettings="tnum"
                            android:gravity="end"
                            android:textColor="#EAF2F1"
                            android:textSize="13sp"
                            tools:text="02.11.2026 16:41:22" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- ── Actions, held at the bottom ─────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="14dp"
            android:paddingBottom="20dp">

            <!-- A request scanned in the SDK: nowhere to return to. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDone"
                style="@style/Widget.Eimzo.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="58dp"
                android:text="@string/eimzo_ui_done"
                android:textColor="#08251E"
                android:textSize="17sp"
                android:visibility="gone"
                app:backgroundTint="@color/eimzo_ui_accent" />

            <!-- The countdown fills this button from the left. The bar IS the
                 timer: it is the only thing saying the SDK is about to leave,
                 so it belongs on the button that will fire. -->
            <FrameLayout
                android:id="@+id/btnReturn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/eimzo_ui_bg_counting_button"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:minHeight="58dp">

                <!-- Sized by the fragment to the button: match_parent here
                     would let it, not the label, decide the button's height. -->
                <View
                    android:id="@+id/countFill"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:background="#42FFFFFF" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:minHeight="58dp"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/eimzo_ui_ic_back"
                        app:tint="#08251E" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:text="@string/eimzo_ui_return_to_app"
                        android:textColor="#08251E"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/countdownRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="13dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/eimzo_ui_ic_timer"
                    app:tint="@color/eimzo_ui_signed_muted" />

                <TextView
                    android:id="@+id/tvCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/eimzo_ui_signed_muted"
                    android:textSize="12.5sp"
                    tools:text="3 soniyadan so‘ng avtomatik qaytadi" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
