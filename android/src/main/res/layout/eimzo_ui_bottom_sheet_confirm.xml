<?xml version="1.0" encoding="utf-8"?>
<!--
  C7 — a destructive confirmation, the app's DestructiveConfirmSheet: a 64dp
  tile in danger at 11% with the action's mark, the question, what it means,
  a red button 56 high, and "Bekor qilish" under it. Replaces the AlertDialog
  whose green ALL-CAPS "DELETE" looked like the safe choice.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/eimzo_ui_bg_sheet"
    android:fillViewport="true"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="44dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/eimzo_ui_sheet_grabber" />

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:background="@drawable/eimzo_ui_bg_badge_danger">

            <ImageView
                android:id="@+id/confirmIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/eimzo_ui_ic_delete"
                app:tint="@color/eimzo_ui_danger" />
        </FrameLayout>

        <TextView
            android:id="@+id/confirmTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:textColor="@color/eimzo_ui_text"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="Kalitni o‘chirasizmi?" />

        <TextView
            android:id="@+id/confirmBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="9dp"
            android:layout_marginEnd="12dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:textColor="@color/eimzo_ui_text_muted"
            android:textSize="14sp"
            tools:text="“TOSHMATOV ALISHER” kaliti telefondan o‘chiriladi." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/confirmAction"
            style="@style/Widget.Eimzo.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:minHeight="56dp"
            android:text="@string/eimzo_ui_delete"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:backgroundTint="@color/eimzo_ui_danger_button" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/confirmCancel"
            style="@style/Widget.Eimzo.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="54dp"
            android:text="@string/eimzo_ui_cancel" />
    </LinearLayout>
</ScrollView>
