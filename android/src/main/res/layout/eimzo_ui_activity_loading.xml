<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eimzo_ui_background">

    <!-- C8: the licence and gateway check, said in words under the spinner. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="120dp"
        android:accessibilityLiveRegion="polite"
        android:gravity="center"
        android:text="@string/eimzo_ui_checking"
        android:textColor="@color/eimzo_ui_text_muted"
        android:textSize="14sp" />

    <FrameLayout
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_gravity="center"
        android:importantForAccessibility="noHideDescendants">

        <com.airbnb.lottie.LottieAnimationView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:lottie_rawRes="@raw/eimzo_spinner"
            app:lottie_autoPlay="true"
            app:lottie_loop="true" />

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:src="@drawable/eimzo_logo_small"
            android:contentDescription="@null" />
    </FrameLayout>
</FrameLayout>
