<?xml version="1.0" encoding="utf-8"?>
<!--
  C3 — the password sheet, for the two kinds of key whose secret is a real
  password: a .pfx file and a QR key. The app's add_key_flow password sheet.

  Replaces the AlertDialog the SDK used: a system dialog in the host's theme,
  with "Parolni saqlash" and "Qo'shish" hardcoded in Uzbek (and "Qo'shish" on
  the button that signed), no way to see what was typed, and an empty entry
  that closed it silently.

  Header tile 42 with the password mark, the field 56 high at radius 16 in a
  4dp accent ring, an inline error, the save switch only when adding a key,
  and the two buttons in one row: "Bekor qilish" 110 wide, "Davom etish"
  taking the rest.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/eimzo_ui_bg_sheet"
    android:fillViewport="true"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="44dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/eimzo_ui_sheet_grabber" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/eimzo_ui_bg_icon_tile_sm">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/eimzo_ui_ic_password"
                    app:tint="@color/eimzo_ui_accent_dark" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/passwordTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/eimzo_ui_text"
                    android:textSize="17.5sp"
                    android:textStyle="bold"
                    tools:text="ERI parolini kiriting" />

                <TextView
                    android:id="@+id/passwordSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="@color/eimzo_ui_text_muted"
                    android:textSize="12.5sp"
                    tools:text=".pfx fayl telefon xotirasidan" />
            </LinearLayout>
        </LinearLayout>

        <!-- The field: 56 inside a 4dp ring, hence 64 with -4 margins. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-4dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="-4dp"
            android:background="@drawable/eimzo_ui_bg_password_field"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp">

            <EditText
                android:id="@+id/passwordInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/eimzo_ui_password_hint"
                android:importantForAutofill="no"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:textColor="@color/eimzo_ui_text"
                android:textColorHint="@color/eimzo_ui_text_muted"
                android:textCursorDrawable="@null"
                android:textSize="19sp" />

            <ImageButton
                android:id="@+id/passwordToggle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/eimzo_ui_show_password"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/eimzo_ui_ic_visibility"
                app:tint="@color/eimzo_ui_text_secondary" />
        </LinearLayout>

        <!-- A rejected password says so here, where the next one is typed. -->
        <LinearLayout
            android:id="@+id/passwordError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/eimzo_ui_bg_error_note"
            android:orientation="horizontal"
            android:paddingStart="13dp"
            android:paddingTop="11dp"
            android:paddingEnd="13dp"
            android:paddingBottom="11dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:importantForAccessibility="no"
                android:src="@drawable/eimzo_ui_ic_error"
                app:tint="@color/eimzo_ui_danger" />

            <TextView
                android:id="@+id/passwordErrorText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                android:lineSpacingMultiplier="1.15"
                android:textColor="@color/eimzo_ui_danger_text"
                android:textSize="12.5sp"
                tools:text="Parol noto‘g‘ri" />
        </LinearLayout>

        <!-- Only when adding a key: a signature never stores a secret. -->
        <LinearLayout
            android:id="@+id/passwordSaveRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/passwordSaveLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/eimzo_ui_save_password"
                    android:textColor="@color/eimzo_ui_text"
                    android:textSize="14.5sp" />

                <TextView
                    android:id="@+id/passwordSaveHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/eimzo_ui_save_password_hint"
                    android:textColor="@color/eimzo_ui_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/passwordSave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:checked="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/passwordCancel"
                style="@style/Widget.Eimzo.Button.Secondary"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/eimzo_ui_cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/passwordContinue"
                style="@style/Widget.Eimzo.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:enabled="false"
                android:minHeight="54dp"
                android:text="@string/eimzo_ui_continue"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
