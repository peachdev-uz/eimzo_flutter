<?xml version="1.0" encoding="utf-8"?>
<!--
  3c — the empty state, measured off the design frame.

  The screen a user with no keys lands on. Before this the SDK showed a small
  "Kalitlar mavjud emas" card and one "ERI qo'shish" row, which named one of
  the four ways in and hid the rest.

  Numbers: hero 98 at radius 32, title 24sp, card 345 at radius 20 with four
  78dp rows and hairlines indented to 76, then a labelled rule and TEZ IMZO at
  55 high, radius 16, accent at 13%.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/emptyState"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <FrameLayout
        android:layout_width="98dp"
        android:layout_height="98dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="34dp"
        android:background="@drawable/eimzo_ui_bg_hero_tile">

        <ImageView
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/eimzo_ui_ic_keys"
            app:tint="@color/eimzo_ui_accent" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:letterSpacing="-0.01"
        android:text="@string/eimzo_ui_add_key_sheet_title"
        android:textColor="@color/eimzo_ui_text"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="9dp"
        android:layout_marginEnd="14dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="@string/eimzo_ui_empty_state_subtitle"
        android:textColor="@color/eimzo_ui_text_hint"
        android:textSize="14.5sp" />

    <!-- One card, four routes, hairlines between. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:background="@drawable/eimzo_ui_bg_card"
        android:orientation="vertical">

        <include
            android:id="@+id/emptyFile"
            layout="@layout/eimzo_ui_item_option_row_flat" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="76dp"
            android:background="@color/eimzo_ui_divider" />

        <include
            android:id="@+id/emptyQr"
            layout="@layout/eimzo_ui_item_option_row_flat" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="76dp"
            android:background="@color/eimzo_ui_divider" />

        <include
            android:id="@+id/emptyNfc"
            layout="@layout/eimzo_ui_item_option_row_flat" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="76dp"
            android:background="@color/eimzo_ui_divider" />

        <include
            android:id="@+id/emptyUsb"
            layout="@layout/eimzo_ui_item_option_row_flat" />
    </LinearLayout>

    <!-- A rule with its label sitting in the gap: the quick-sign route is an
         alternative to the four above, not a fifth one. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="center_vertical"
            android:background="@color/eimzo_ui_hairline" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@color/eimzo_ui_background"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/eimzo_ui_use_without_key"
            android:textColor="@color/eimzo_ui_text_hint"
            android:textSize="11sp" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/btnQuickSign"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="17dp"
        android:background="@drawable/eimzo_ui_bg_quick_sign"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/eimzo_ui_ic_bolt"
            app:tint="@color/eimzo_ui_accent_dark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:letterSpacing="0.04"
            android:text="@string/eimzo_ui_quick_sign"
            android:textColor="@color/eimzo_ui_accent_dark"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
