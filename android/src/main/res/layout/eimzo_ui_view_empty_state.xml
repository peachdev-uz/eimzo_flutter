<?xml version="1.0" encoding="utf-8"?>
<!--
  3c / C9 — Home with no key: a hero tile, "Kalit qo'shing", what a key is
  for, and the one routes list the add-key sheet shows too.

  No "Kalit qo'shmasdan foydalanish" / TEZ IMZO under it any more (A8): with
  no request it opened the scanner into a confirmation with no key to sign
  with, and with one it was a USB-only path nobody could find.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/emptyState"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingBottom="16dp">

    <FrameLayout
        android:layout_width="98dp"
        android:layout_height="98dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:background="@drawable/eimzo_ui_bg_hero_tile">

        <ImageView
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/eimzo_ui_ic_keys"
            app:tint="@color/eimzo_ui_accent" />
    </FrameLayout>

    <TextView
        android:id="@+id/emptyTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:letterSpacing="-0.01"
        android:text="@string/eimzo_ui_empty_state_title"
        android:textColor="@color/eimzo_ui_text"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="9dp"
        android:layout_marginEnd="14dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="@string/eimzo_ui_empty_state_subtitle"
        android:textColor="@color/eimzo_ui_text_muted"
        android:textSize="14.5sp" />

    <include
        android:id="@+id/routes"
        layout="@layout/eimzo_ui_view_add_key_routes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp" />
</LinearLayout>
