<?xml version="1.0" encoding="utf-8"?>
<!--
  A non-default key in the list (3d).

  The design gives the default key the full gradient card and everything else
  this 80dp row with a 44×32 thumbnail of that same card. The thumbnail is what
  keeps the two readings connected — a row is the card, small.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rowRoot"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:layout_marginStart="20dp"
    android:layout_marginTop="10dp"
    android:layout_marginEnd="20dp"
    android:background="@drawable/eimzo_ui_bg_option_row"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <View
        android:id="@+id/thumb"
        android:layout_width="44dp"
        android:layout_height="32dp"
        tools:background="@drawable/eimzo_ui_thumb_personal" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="13dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lineSpacingExtra="1dp"
            android:maxLines="2"
            android:textColor="@color/eimzo_ui_text"
            android:textSize="14.5sp"
            android:textStyle="bold"
            tools:text="BAXTIYOROVA N. ALISHER QIZI" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Only on an expired key: the red line needs a mark so it is not
                 just "text that happens to be red". -->
            <ImageView
                android:id="@+id/ivExpired"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="5dp"
                android:importantForAccessibility="no"
                android:src="@drawable/eimzo_ui_ic_error"
                android:visibility="gone"
                app:tint="@color/eimzo_ui_danger"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvMeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/eimzo_ui_text_hint"
                android:textSize="12sp"
                tools:text="ERI · jismoniy shaxs · 12.03.2027" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/btnMore"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/eimzo_ui_delete_key"
        android:focusable="true"
        android:src="@drawable/eimzo_ui_ic_more_vert"
        app:tint="@color/eimzo_ui_chevron" />

</LinearLayout>
