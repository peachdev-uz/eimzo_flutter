<?xml version="1.0" encoding="utf-8"?>
<!--
  3d — one key in the list, drawn as the design's teal card.

  Rewritten from the pre-redesign version, which hardcoded every colour
  (#B3FFFFFF, #FFD54F …) and so stayed light when the phone went dark, and
  carried three `visibility="gone"` placeholder views left over from an older
  layout. What is on the card now is what the design puts there: a status chip,
  the kind's artwork, the owner's name, and two labelled footer fields.

  The kind badge is the part that was missing entirely — every key wore the
  same face, so a USB token key and a .pfx key were indistinguishable once
  saved. `KeyAdapter` sets the artwork and the label from `KeyType`.
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="196dp"
        android:background="@drawable/eimzo_ui_gradient_card"
        android:clipChildren="true"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="18dp"
        android:paddingBottom="16dp">

        <!-- Decorative ring bleeding off the top-right corner. Behind
             everything, and clipped by the card's own bounds. -->
        <View
            android:layout_width="190dp"
            android:layout_height="190dp"
            android:layout_marginTop="-58dp"
            android:layout_marginEnd="-58dp"
            android:background="@drawable/eimzo_ui_card_ring"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Kind chip: "ERI" / "ID-karta" / "Token". The eye catches this
             before it reads the name. -->
        <TextView
            android:id="@+id/tvKindPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/eimzo_ui_bg_status_pill"
            android:letterSpacing="0.06"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="ERI" />

        <!-- Expired keys cannot sign at all, so the badge sits next to the kind
             chip rather than somewhere the eye has to find it. -->
        <TextView
            android:id="@+id/tvExpiredBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/eimzo_ui_bg_expired_badge"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="@string/eimzo_ui_key_expired"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@id/tvKindPill"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />

        <!-- The kind's artwork. The token has no logo of its own and draws the
             USB glyph instead — KeyAdapter swaps between the two. -->
        <ImageView
            android:id="@+id/ivKindLogo"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/eimzo_ui_logo_card" />

        <!-- Marks the key the sign flow will use. -->
        <ImageView
            android:id="@+id/ivDefault"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/eimzo_ui_ic_star"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivKindLogo"
            app:tint="#FFD54F"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:letterSpacing="0.05"
            android:lineSpacingMultiplier="1.3"
            android:maxLines="2"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            app:layout_constraintBottom_toTopOf="@id/lblPinfl"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvKindPill"
            app:layout_constraintVertical_bias="0.62"
            tools:text="BAXTIYOROV XALILJON" />

        <TextView
            android:id="@+id/lblPinfl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="@string/eimzo_ui_label_jshshir"
            android:textColor="#8CFFFFFF"
            android:textSize="10.5sp"
            app:layout_constraintBottom_toTopOf="@id/tvPinfl"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvPinfl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guidelineMid"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="30101901234567" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidelineMid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.58" />

        <TextView
            android:id="@+id/lblExpiry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="@string/eimzo_ui_label_duration"
            android:textColor="#8CFFFFFF"
            android:textSize="10.5sp"
            app:layout_constraintBottom_toTopOf="@id/tvExpiry"
            app:layout_constraintStart_toStartOf="@id/guidelineMid" />

        <TextView
            android:id="@+id/tvExpiry"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/guidelineMid"
            tools:text="2027.05.14" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
