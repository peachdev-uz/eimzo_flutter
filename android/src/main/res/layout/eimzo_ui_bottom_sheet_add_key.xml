<?xml version="1.0" encoding="utf-8"?>
<!--
  3c / C9 — the add-key method picker: the title, the question, the one
  routes list the empty Home shows too, and «Bekor qilish». Scrolls when it
  does not fit — sideways, or at a large font size.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/eimzo_ui_bg_sheet"
    android:fillViewport="true"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="44dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/eimzo_ui_sheet_grabber" />

        <TextView
            android:id="@+id/addTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/eimzo_ui_add_key_sheet_title"
            android:textColor="@color/eimzo_ui_text"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/eimzo_ui_add_key_sheet_subtitle"
            android:textColor="@color/eimzo_ui_text_muted"
            android:textSize="13.5sp" />

        <include
            android:id="@+id/routes"
            layout="@layout/eimzo_ui_view_add_key_routes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.Eimzo.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="52dp"
            android:text="@string/eimzo_ui_cancel" />
    </LinearLayout>
</ScrollView>
