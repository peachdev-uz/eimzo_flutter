<?xml version="1.0" encoding="utf-8"?>
<!--
  3c — the add-key method picker.

  Four routes now, in the design's order: file, QR, NFC, USB. The USB row is the
  new one — the SDK used to hide it here and offer USB only as a sign-only
  button on Home, which is why an Android integrator could not save a token as a
  key while an iOS one could.

  Rows are <include>d so all four share one definition. Each include needs its
  own id, and ids inside an included layout are addressed through it
  (`binding.optionUsb.optionTitle`), which is what keeps the four bindings apart.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/eimzo_ui_bg_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="34dp">

    <View
        android:layout_width="44dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/eimzo_ui_sheet_grabber" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="@string/eimzo_ui_add_key_sheet_title"
        android:textColor="@color/eimzo_ui_text"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/eimzo_ui_add_key_sheet_subtitle"
        android:textColor="@color/eimzo_ui_text_hint"
        android:textSize="13.5sp" />

    <include
        android:id="@+id/optionFile"
        layout="@layout/eimzo_ui_item_option_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp" />

    <include
        android:id="@+id/optionQr"
        layout="@layout/eimzo_ui_item_option_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp" />

    <include
        android:id="@+id/optionNfc"
        layout="@layout/eimzo_ui_item_option_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp" />

    <include
        android:id="@+id/optionUsb"
        layout="@layout/eimzo_ui_item_option_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancel"
        style="@style/Widget.Eimzo.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:text="@string/eimzo_ui_cancel" />

</LinearLayout>
