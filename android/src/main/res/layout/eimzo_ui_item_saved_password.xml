<?xml version="1.0" encoding="utf-8"?>
<!-- One key with a stored secret (F2): its swatch, name and kind, and
     "O'chirish" — which forgets the secret only; the key stays. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="4dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:id="@+id/savedThumb"
        android:layout_width="44dp"
        android:layout_height="32dp"
        tools:background="@drawable/eimzo_ui_swatch_file">

        <ImageView
            android:id="@+id/savedMark"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_gravity="center"
            android:alpha="0.88"
            android:importantForAccessibility="no"
            app:tint="#FFFFFF"
            tools:src="@drawable/eimzo_ui_ic_keys" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/savedName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAllCaps="true"
            android:textColor="@color/eimzo_ui_text"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="TOSHMATOV ALISHER" />

        <TextView
            android:id="@+id/savedKind"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/eimzo_ui_text_muted"
            android:textSize="12.5sp"
            tools:text="ID-karta" />
    </LinearLayout>

    <TextView
        android:id="@+id/savedDelete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/eimzo_ui_delete"
        android:textColor="@color/eimzo_ui_danger_text"
        android:textSize="13.5sp"
        android:textStyle="bold" />
</LinearLayout>
