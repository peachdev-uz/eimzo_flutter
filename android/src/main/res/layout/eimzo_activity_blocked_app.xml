<?xml version="1.0" encoding="utf-8"?>
<!--
  B6 — the SDK is refused in this app: the same screen on Android and iOS.

  A lock in a tinted tile, "E-IMZO bu ilovada ishlamaydi", and one sentence
  for the reason — the app is not registered or was suspended, or the device
  could not be verified. Under "Ishlab chiquvchi uchun", folded away, what the
  integrator needs: the package name, the technical reason, "Nusxalash", and
  info@yt.uz with a mail button. ✕ closes.

  It used to tell every user — the one with a rooted phone included — to
  register as an integrator, under a toolbar with an untinted system ✕ and
  hardcoded Uzbek throughout.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/eimzoBlockedRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eimzo_ui_background"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/btnBlockedClose"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="6dp"
        android:layout_marginTop="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/eimzo_ui_close"
        android:focusable="true"
        android:padding="12dp"
        android:src="@drawable/eimzo_ui_ic_close"
        app:tint="@color/eimzo_ui_text" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/eimzo_ui_bg_badge_danger">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/eimzo_ui_ic_lock"
                    app:tint="@color/eimzo_ui_danger" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvBlockedTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:text="@string/eimzo_ui_blocked_title"
                android:textColor="@color/eimzo_ui_text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBlockedBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.3"
                android:textColor="@color/eimzo_ui_text_muted"
                android:textSize="14.5sp"
                tools:text="@string/eimzo_ui_blocked_body_app" />

            <!-- "Ishlab chiquvchi uchun" — folded until asked for. -->
            <LinearLayout
                android:id="@+id/developerCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/eimzo_ui_bg_card"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/developerToggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="14dp">

                    <TextView
                        android:id="@+id/tvDeveloper"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/eimzo_ui_blocked_developer"
                        android:textColor="@color/eimzo_ui_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/developerChevron"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:rotation="90"
                        android:src="@drawable/eimzo_ui_ic_chevron_right"
                        app:tint="@color/eimzo_ui_chevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/developerDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="18dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.06"
                        android:text="@string/eimzo_ui_blocked_package"
                        android:textColor="@color/eimzo_ui_text_muted"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/tvPackage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="monospace"
                        android:textColor="@color/eimzo_ui_text"
                        android:textIsSelectable="true"
                        android:textSize="13sp"
                        tools:text="uz.example.app" />

                    <TextView
                        android:id="@+id/lblReason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:letterSpacing="0.06"
                        android:text="@string/eimzo_ui_blocked_reason"
                        android:textColor="@color/eimzo_ui_text_muted"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/tvReason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="@color/eimzo_ui_text"
                        android:textIsSelectable="true"
                        android:textSize="13sp"
                        tools:text="Ilova E-IMZO gateway'ida ro'yxatdan o'tmagan." />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCopyDetails"
                        style="@style/Widget.Eimzo.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:minHeight="48dp"
                        android:text="@string/eimzo_ui_copy"
                        android:textSize="15sp"
                        app:icon="@drawable/eimzo_ui_ic_copy"
                        app:iconGravity="textStart"
                        app:iconSize="18dp"
                        app:iconTint="@color/eimzo_ui_text_secondary" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/eimzo_ui_divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvContactEmail"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/eimzo_ui_contact_email"
                            android:textColor="@color/eimzo_ui_text"
                            android:textIsSelectable="true"
                            android:textSize="14.5sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMail"
                            style="@style/Widget.Eimzo.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="44dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:text="@string/eimzo_ui_blocked_mail"
                            android:textSize="14sp"
                            app:icon="@drawable/eimzo_ui_ic_mail"
                            app:iconSize="18dp"
                            app:iconTint="@color/eimzo_ui_button_text" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
